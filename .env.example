# Backend: auto | drive | gmail | memory
STORAGE=auto

# REST server (gmail-bucket serve)
PORT=4566
HOST=127.0.0.1

# Optional bearer token for the REST API
# GMAIL_BUCKET_TOKEN=

# ---------- Drive base folder ----------
# DRIVE_ROOT_FOLDER_ID=
# DRIVE_ROOT_FOLDER_NAME=bucket-base
# DRIVE_CREATE_ROOT=1

# ---------- Gmail backend ----------
# GMAIL_BUCKET_ROOT_LABEL=gmail-bucket
# GMAIL_BUCKET_DIR=

# ---------- credentials without ~/.gmail-bucket ----------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
