{
  "name": "gmail-bucket",
  "version": "2.1.0",
  "description": "Use Google Drive or Gmail as a tiny S3-style object store: a base folder, buckets as folders, nested keys. Demo and MVP use only.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "gmail-bucket": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test:drive": "npm run build && node test/drive-mock-test.mjs",
    "auth": "node dist/cli.js auth",
    "serve": "node dist/cli.js serve"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "googleapis": "^144.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  },
  "license": "MIT",
  "keywords": [
    "gmail",
    "google-drive",
    "s3",
    "object-store",
    "file-storage",
    "storage",
    "backup",
    "mvp"
  ],
  "author": {
    "name": "Muhammad Waqar"
  },
  "homepage": "https://github.com/muhammad-waqar-uit/gmail-bucket",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muhammad-waqar-uit/gmail-bucket.git"
  },
  "bugs": {
    "url": "https://github.com/muhammad-waqar-uit/gmail-bucket/issues"
  }
}
